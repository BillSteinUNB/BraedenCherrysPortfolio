{
  "framework": "vite",
  "buildCommand": "cd app && npm install && npm run build",
  "outputDirectory": "app/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/book",
      "destination": "https://getsqr.co/braeden-taylor-3",
      "permanent": false
    },
    {
      "source": "/book/",
      "destination": "https://getsqr.co/braeden-taylor-3",
      "permanent": false
    }
  ]
}
